<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed background. Android crops an adaptive icon to whatever shape the
     launcher uses, so this layer must reach every edge of the 108dp canvas. That
     is what removes the pale corners the old square PNG left behind. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#14110F"
        android:pathData="M0,0h108v108h-108z" />
</vector>
